#!/bin/bash
#SBATCH --job-name=llama-3.1-8b-instruct-outlook

#SBATCH --partition=kisski
#SBATCH --gres=gpu:1

#SBATCH --cpus-per-task=8
#SBATCH --mem=64G

#SBATCH --time=08:00:00

#SBATCH --array=0-43%4

#SBATCH --output=results/outlook/llama-3.1-8b-instruct/logs/%x_%A_%a.out

source ~/lora-thesis/lora-env/bin/activate

cd ~/lora-thesis

mkdir -p results/outlook/llama-3.1-8b-instruct/logs/

#
# 44 array tasks = 4 datasets x 11 runs/dataset (1 zeroshot + 1 fft +
# 3 targets x 3 rank/alpha tiers) -- generated by
# scripts/generate_outlook_slurm.py, not hand-written; regenerate rather
# than hand-edit if configs/outlook/llama-3.1-8b-instruct/ changes. Every task passes
# an explicit grid index (0 for the single-point zeroshot/fft configs
# too), same convention the main study's own multi-point-grid .slurm
# files use.
#

CONFIGS=(
  "configs/outlook/llama-3.1-8b-instruct/mnli/00_zeroshot.yaml"
